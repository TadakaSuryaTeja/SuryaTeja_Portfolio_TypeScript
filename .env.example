# ---------------------------------------------------------------------------
# All variables below are OPTIONAL and SERVER-SIDE ONLY.
# The site builds and renders completely without any of them, falling back to
# the local content in portfolio.ts. Never prefix any of these with
# NEXT_PUBLIC_ — that would ship the secret to the browser bundle.
# ---------------------------------------------------------------------------

# Notion CMS (Insights / Case Studies / AI Lab).
# Create an internal integration at https://www.notion.so/my-integrations,
# then share each database with it.
NOTION_TOKEN=
NOTION_ARTICLES_DATABASE_ID=
NOTION_CASE_STUDIES_DATABASE_ID=
NOTION_AI_LAB_DATABASE_ID=

# GitHub proof-of-work. Unauthenticated requests work (60/hr); a fine-grained
# token with public read-only access raises the limit for busy builds.
GITHUB_TOKEN=
