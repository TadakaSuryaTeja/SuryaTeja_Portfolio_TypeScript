{
  "name": "suryateja-portfolio",
  "version": "2.0.0",
  "description": "Personal portfolio of Surya Teja Tadaka — Technical Lead, Enterprise AI & Agentic Systems Engineer. Next.js, TypeScript, Tailwind CSS, Framer Motion.",
  "author": "Surya Teja Tadaka",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run gen:rag && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:og": "node scripts/generate-og.mjs",
    "gen:favicon": "node scripts/generate-favicon.mjs",
    "build:resume": "node scripts/build-resume.mjs",
    "check:content": "tsx scripts/check-content.ts",
    "gen:sitemap": "tsx scripts/generate-sitemap.ts",
    "gen:rag": "tsx scripts/build-embeddings.ts",
    "rag:query": "tsx scripts/query-rag.ts",
    "eval": "tsx evals/run.ts",
    "eval:offline": "tsx evals/run.ts --offline",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run lint && tsc --noEmit && npm test && npm run eval:offline"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.2",
    "@vercel/speed-insights": "^2.0.0",
    "@xenova/transformers": "^2.17.2",
    "framer-motion": "^11.18.2",
    "next": "^13.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.23",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.87",
    "@iconify-json/vscode-icons": "^1.2.59",
    "@iconify/utils": "^2.3.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.23",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^13.5.6",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.4.3"
  }
}
